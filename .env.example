PORT=3000
ADMIN_PASSWORD=replace-with-a-long-unique-admin-password
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# Required private key: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INFINITY_AUTH_KEY=
COOKIE_SECURE=false
# Required production origin, e.g. https://courses.example.org (no trailing slash)
APP_ORIGIN=
# Enable only behind a trusted proxy that overwrites forwarding headers and
# prevents direct public access to the Node port.
TRUST_PROXY=false
# Optional explicit additional HTTPS CDN hostnames, comma-separated; no wildcards.
INFINITY_PLAYBACK_HOSTS=

# Set this to the mounted persistent volume path in production.
STATE_DIR=/data

# Catalog ADMINISTRATION ONLY. Never used for viewer playback.
# Optional. If omitted, save/replace the cookie from the admin panel instead.
INFINITY_COOKIE=

# Automatic Video-ID scanner (daily by default)
AUTO_SCAN_ENABLED=true
AUTO_SCAN_INTERVAL_HOURS=24
AUTO_SCAN_MAX_MISSES=1000
AUTO_SCAN_BATCH_SIZE=25
AUTO_SCAN_WORKERS=5
